{
  "name": "project-strict-check-homepage",
  "license": "UNLICENSED",
  "author": "akky-xxxx",
  "engines": {
    "node": "26.5.0",
    "npm": "pnpmを使用してください",
    "yarn": "pnpmを使用してください"
  },
  "scripts": {
    "build": "run-s build:pathpida build:next",
    "build-storybook": "storybook build",
    "build:next": "next build",
    "build:pathpida": "pathpida --ignorePath .gitignore",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "check-code": "npm-run-all -p lint spell-check type-check -s test-jest",
    "deploy": "$npm_execpath run pages:build && wrangler pages deploy",
    "dev": "run-p dev:*",
    "dev:next": "next dev",
    "dev:path": "pathpida --ignorePath .gitignore --watch",
    "fix": "run-p -c \"fix:*\"",
    "fix:config": "eslint -c eslint.config.js.mjs \"./\" --max-warnings 0 --fix",
    "fix:pack": "fixpack",
    "fix:prettier": "prettier \"./*.{json,toml,yaml,yml}\" \"./**/*.{json,toml,yaml,yml}\" \"!pnpm-lock.yaml\" -w -u",
    "fix:product-code": "eslint \"src/*/*.ts{,x}\" \"src/**/*.ts{,x}\" --max-warnings 0 --fix",
    "lint": "run-p -c \"lint:*\"",
    "lint:config": "eslint -c eslint.config.js.mjs \"./\" --max-warnings 0",
    "lint:pack": "fixpack --dryRun",
    "lint:prettier": "prettier \"./*.{json,toml,yaml,yml}\" \"./**/*.{json,toml,yaml,yml}\" \"!pnpm-lock.yaml\" -c -u",
    "lint:product-code": "eslint \"src/*/*.ts{,x}\" \"src/**/*.ts{,x}\" --max-warnings 0",
    "log": "wrangler pages deployment tail --project-name strict-check-series --environment preview",
    "pages:build": "npx @cloudflare/next-on-pages",
    "prepare": "run-s \"prepare:*\"",
    "prepare-bk:playwright": "pnpm exec playwright install",
    "prepare:huksy": "husky",
    "prepare:panda": "panda codegen",
    "prepare:pathpida": "pnpm build:pathpida",
    "preview": "$npm_execpath run pages:build && wrangler pages dev",
    "spell-check": "cspell lint --no-progress \"./**/*.{js,mjs,ts,tsx}\" \"./*.{js,mjs}\"",
    "start": "next start",
    "storybook": "run-s build:pathpida storybook:storybook",
    "storybook:storybook": "storybook dev -p 6006",
    "test-jest": "jest --coverage",
    "test-storybook": "test-storybook",
    "type-check": "tsc"
  },
  "dependencies": {
    "js-cookie": "3.0.8",
    "next": "16.2.10",
    "pathpida": "0.26.1",
    "preact": "10.29.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hot-toast": "2.6.0",
    "react-syntax-highlighter": "16.1.1",
    "valibot": "1.4.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^2.0.2",
    "@cloudflare/next-on-pages": "1.13.16",
    "@cloudflare/workers-types": "5.20260719.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/eslintrc": "3.3.6",
    "@pandacss/dev": "1.11.4",
    "@storybook/addon-essentials": "8.3.2",
    "@storybook/addon-interactions": "8.3.2",
    "@storybook/addon-links": "8.3.2",
    "@storybook/addon-onboarding": "8.3.2",
    "@storybook/blocks": "8.3.2",
    "@storybook/nextjs": "8.3.2",
    "@storybook/react": "8.3.2",
    "@storybook/test": "8.3.2",
    "@storybook/test-runner": "0.19.1",
    "@swc/core": "1.15.46",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@tsconfig/next": "2.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/jest": "30.0.0",
    "@types/js-cookie": "3.0.6",
    "@types/node": "22.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "cspell": "10.0.1",
    "eslint": "8.57.0",
    "eslint-config-sc-all": "0.0.5",
    "eslint-config-sc-jest": "0.0.5",
    "eslint-config-sc-js": "0.0.9",
    "eslint-config-sc-next": "0.0.3",
    "eslint-config-sc-storybook": "0.0.5",
    "eslint-config-sc-ts": "0.0.7",
    "eslint-plugin-jsdoc": "50.2.4",
    "eslint-plugin-next-on-pages": "1.13.16",
    "eslint-plugin-sc-js": "0.0.5",
    "eslint-plugin-sonarjs": "2.0.2",
    "eslint-plugin-storybook": "0.8.0",
    "fixpack": "4.0.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "next-router-mock": "1.0.5",
    "npm-run-all2": "9.0.2",
    "playwright": "1.61.1",
    "postcss": "8.5.20",
    "prettier": "3.9.5",
    "storybook": "8.3.2",
    "typescript": "5.6.2",
    "typescript-eslint": "8.64.0",
    "vercel": "56.3.2",
    "wrangler": "4.112.0"
  },
  "version": "0.0.1",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
